{
  "name": "omnifeed",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=@omnifeed/api",
    "dev:mobile": "npm run start --workspace=@omnifeed/mobile",
    "build:api": "npm run build --workspace=@omnifeed/api",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
