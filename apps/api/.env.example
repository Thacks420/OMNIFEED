PORT=3000

# Reddit Data API OAuth (server-side only)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=android:omnifeed:v0.1.0 (by /u/YOUR_REDDIT_USERNAME)
REDDIT_SUBREDDIT=popular

# YouTube Data API v3 (server-side only)
YOUTUBE_API_KEY=
YOUTUBE_REGION=US

# Durable cursor state for one API instance (mount a persistent volume in production)
FEED_SESSION_DIR=.data/feed-sessions
